{
   "content_scripts": [
      {
         "css": [
            "sprint-helper.css"
         ],
         "js": [
            "jquery-2.1.4.min.js",
            "feature-preferences.js",
            "sprint-helper.js",
            "title-points-editor.js",
            "comment-layout.js",
            "charts.js",
            "eow-update.js",
            "hover-selectors.js"
         ],
         "matches": [
            "https://trello.com/*"
         ]
      }
   ],
   "description": "Sprint Helper by Dheeraj. Built on TrelloScrum: points, members burndown, Attention filters, weekly updates and Slack previews.",
   "icons": {
      "128": "sprint-helper-icon.png"
   },
   "manifest_version": 3,
   "name": "Sprint Helper",
   "permissions": [
      "storage"
   ],
   "version": "1.107",
   "web_accessible_resources": [
      {
         "matches": [
            "<all_urls>"
         ],
         "resources": [
            "images/storypoints-icon.png",
            "images/points-done.png",
            "images/burndown-icon_12x12.png",
            "images/burndown-icon_18x18.png",
            "images/sprint-helper-icon_12x12.png",
            "images/sprint-helper-icon_18x18.png"
         ]
      }
   ]
}
